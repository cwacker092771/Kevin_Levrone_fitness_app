# Local Postgres connection (used when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=levrone_fitness
PGUSER=
PGPASSWORD=

# Production: a single connection string. Managed Postgres (RDS, Render, etc.)
# provides this. TLS is used automatically unless PGSSL=disable.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Set in production so static asset caching, error output and Secure cookies
# behave correctly.
# NODE_ENV=production

# Override the Secure cookie flag independently of NODE_ENV. Leave unset for
# normal HTTPS deployments; set to "false" only when serving over plain HTTP.
# COOKIE_SECURE=true

# Port the Node process listens on (the reverse proxy forwards to this).
# PORT=3000

# Local-dev HTTPS. Set HTTPS_PORT to serve TLS there (cert pair from
# `npm run gen-cert` in ./certs) and 301-redirect the plain PORT to it.
# `npm run dev:https` sets this to 3443. Leave unset in production.
# HTTPS_PORT=3443

# Email verification (Amazon SES). MAIL_FROM must be a verified SES identity.
# If unset, verification links are logged instead of emailed, and (outside
# production) returned in the API response so the flow still works locally.
# MAIL_FROM=The Levrone Protocol <noreply@yourdomain>
# SES_REGION=us-east-2

# Base URL used in verification links. Defaults to the request's own
# scheme+host; set this if the app sits behind something that obscures that.
# APP_URL=https://yourdomain

# Stripe — registration collects a card on file (no charge). If unset, the
# card step is skipped in dev and is a hard error in production. Prefer a
# restricted key (rk_...) scoped to SetupIntents + Customers over a full sk_.
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# TEMPORARY escape hatch: set to false to remove the card step from signup even
# when the Stripe keys above are set. Remove the line to restore it.
# CARD_ON_REGISTRATION=false

# AI "goal physique" portrait (Amazon Bedrock + Rekognition). Off by default -
# it costs money and needs Bedrock image-model access enabled in the console.
# Uses the default AWS credential chain (instance role on EC2, needs
# bedrock:InvokeModel and rekognition:DetectFaces).
#
# Primary path locks the real face: Rekognition finds it, Stable Image Inpaint
# repaints only the body/clothing/background. Falls back to SD3.5 img2img if no
# face is detected or the inpaint call errors.
# GOAL_IMAGE=true
# BEDROCK_REGION=us-west-2
# BEDROCK_INPAINT_MODEL=us.stability.stable-image-inpaint-v1:0
# REKOGNITION_REGION=us-east-1
# BEDROCK_IMAGE_MODEL=stability.sd3-5-large-v1:0   # fallback img2img model
# GOAL_IMAGE_STRENGTH=0.38   # fallback img2img: lower keeps more of the face
