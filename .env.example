# Local Postgres connection (used when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=levrone_fitness
PGUSER=
PGPASSWORD=

# Production: a single connection string (Render/managed Postgres set this automatically)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Password-protect the whole site (required for a public deploy)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
