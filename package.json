{
  "name": "levrone-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "Kevin Levrone-style body composition / nutrition / supplement TODO planner",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env server.js",
