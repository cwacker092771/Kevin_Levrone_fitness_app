    "db:setup": "node db/setup.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1127.0",
    "@aws-sdk/client-rekognition": "^3.1127.0",
    "@aws-sdk/client-ses": "^3.1124.0",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.1"
  }
}
